{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false,
        ".validate": "newData.val() == true"
      }
    },

    "products": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    },

    "categories": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
    },

    "shipping": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
    },

    "orders": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$id": {
        ".write": "!data.exists() || (auth != null && root.child('admins').child(auth.uid).val() == true)",
        ".validate": "(!data.exists() && newData.hasChildren(['customer','items','total','createdAt','status']) && newData.child('customer').hasChildren(['name','phone','governorate','address']) && newData.child('items').hasChildren() && newData.child('total').isNumber() && newData.child('createdAt').isNumber() && newData.child('status').val() == 'new') || (auth != null && root.child('admins').child(auth.uid).val() == true)"
      }
    }
  }
}
